# Copier en backend/.env sur le serveur et renseigner les valeurs.
# NE JAMAIS committer le vrai .env.
PORT=3000

# Base de données PostgreSQL locale
DB_HOST=localhost
DB_PORT=5432
DB_USER=manne_bulles_admin
DB_PASSWORD=
DB_NAME=manne_bulles

# Secret JWT — générer avec : openssl rand -hex 32
JWT_SECRET=

# Origine publique autorisée (CORS Socket.IO).
# Prod : http://164.132.195.129   |   Dev : http://localhost:5173
ORIGINE_CORS=http://localhost:5173

# PIN des utilisatrices — exactement 4 chiffres.
# Lus par scripts/seed-utilisateurs.js (création initiale) ET par
# scripts/mettre-a-jour-utilisateurs.js (changement sur une base déjà peuplée).
PIN_GERANTE=
PIN_REPASSEUSE_1=
PIN_REPASSEUSE_2=

# Noms affichés sur l'écran « choisir son nom ». Optionnels : absents, les noms en base
# restent inchangés. Lus uniquement par scripts/mettre-a-jour-utilisateurs.js.
#
# ⚠️ C'est ICI que vont les vrais prénoms, jamais dans scripts/seed-utilisateurs.js :
# ce fichier-là est versionné sur un dépôt PUBLIC, et y écrire les prénoms des employées
# les publierait. Les noms génériques du seed sont volontairement non identifiants.
NOM_GERANTE=
NOM_REPASSEUSE_1=
NOM_REPASSEUSE_2=

# Jeton dédié de la passerelle SMS (US #240) — générer avec : openssl rand -hex 32
# Doit être identique à celui du .env de la passerelle sur le téléphone.
# S'il est absent, les routes /api/sms répondent 401 (elles ne deviennent jamais publiques).
JETON_PASSERELLE=
