# Copier en passerelle-sms/.env sur le téléphone. NE JAMAIS committer le vrai .env.

# Prod (téléphone de l'atelier) : https://vps-a87c8d0b.vps.ovh.net
# Dev  (portable, backend local) : http://localhost:3000
URL_API=http://localhost:3000

# Doit être identique au JETON_PASSERELLE du backend.
JETON_PASSERELLE=

# Intervalle de scrutation de la file, en millisecondes.
INTERVALLE_MS=30000

# 'console' = simulation journalisée (développement, sans SIM) ; 'sms' = envoi réel (#340).
MODE_ENVOI=console

# Nombre maximum de SMS retirés par passe (borné à 50 côté serveur).
LIMITE_SMS=10
